         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Martyrdom_4')
end


function IsAMPIlmaterStigmaApplied()
    return StatusId('AMP_STIGMA_AMULET_1') | StatusId('AMP_STIGMA_AMULET_2') |
           StatusId('AMP_STIGMA_AMULET_3') | StatusId('AMP_STIGMA_AMULET_4') |
           StatusId('AMP_STIGMA_RING') |
           StatusId('AMP_STIGMA_DIADEM_1') | StatusId('AMP_STIGMA_DIADEM_2') |
           StatusId('AMP_STIGMA_DIADEM_3') | StatusId('AMP_STIGMA_DIADEM_4') |
           StatusId('AMP_STIGMA_ROBE') |
           StatusId('AMP_STIGMA_CLOAK') |
           StatusId('AMP_STIGMA_GLOVES') |
           StatusId('AMP_STIGMA_BOOTS') |
           StatusId('AMP_STIGMA_HELMET_1') | StatusId('AMP_STIGMA_HELMET_2') |
           StatusId('AMP_STIGMA_HELMET_3') | StatusId('AMP_STIGMA_HELMET_4') |
           StatusId('AMP_STIGMA_MEDIUMARMOR_1') | StatusId('AMP_STIGMA_MEDIUMARMOR_2') |
           StatusId('AMP_STIGMA_MEDIUMARMOR_3') | StatusId('AMP_STIGMA_MEDIUMARMOR_4') |
           StatusId('AMP_STIGMA_HEAVYARMOR_1') | StatusId('AMP_STIGMA_HEAVYARMOR_2') |
           StatusId('AMP_STIGMA_HEAVYARMOR_3') | StatusId('AMP_STIGMA_HEAVYARMOR_4')
end


