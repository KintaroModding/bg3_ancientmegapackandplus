-- same timeout as AMP_BossCombat, for fights that replace the combat node outright
-- scripted state is proxied unchanged, no fallback beside it
-- if it cannot be entered the node is skipped, as the original would be
game.states.AMP_BossCombatCustom = State{function ()
    description = [[A scripted combat state with a turn timeout that is held while the party reacts.]]

    params.TurnTimeout = {type = EParamType.Number, required=false, default=30.0, help=[[
        Seconds of silence before the engine force-ends this NPC's turn.
    ]]}

    params.wrapped = {type = EParamType.State, help=[[
        The combat state this fight uses.
    ]]}

    helpers.Arm = function()
        if me.IsInCombat then
            SetCombatTimeout(me, params.TurnTimeout)
        end
    end

    -- repairing a stalled turn rebuilds this tree, which drops the override with it
    self.OnInit = function()
        helpers.Arm()
    end

    -- entry follows the wrapped state, so this node is skipped exactly where the original was
    nodes = Selector{
        CanEnter = function(node)
            return CheckAnySelectable(node)
        end
    }

    nodes.Wrapped = Proxy {
        params.wrapped,
    }

    events.TurnStarted = function()
        helpers.Arm()
    end

    events.TurnEnded = function()
        ResetCombatTimeout(me)
    end

    events.EntityEvent = function(ev)
        if ev.TargetEntity == me then
            if ev.Event == "AMP_Plus_TimerHold" then
                SetCombatTimeout(me, -1.0)
            elseif ev.Event == "AMP_Plus_TimerKick" then
                helpers.Arm()
            end
        end
    end
end}
