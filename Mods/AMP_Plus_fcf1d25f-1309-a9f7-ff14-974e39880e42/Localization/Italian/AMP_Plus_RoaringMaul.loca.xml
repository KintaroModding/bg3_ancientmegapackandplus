	<content contentuid="h8f341453g4b97g4015g8addgefe1294780d6" version="1">Colpo risonante</content>
	<content contentuid="h90a8f125gea89g45degb3cfgc6375b8755a5" version="1">Infliggi &lt;b&gt;inoltre&lt;/b&gt; &lt;b&gt;[1]&lt;/b&gt; ai nemici sotto &lt;LSTag Type="Status" Tooltip="MAG_THUNDER_REVERBERATION"&gt;Riverbero&lt;/LSTag&gt;.</content>
