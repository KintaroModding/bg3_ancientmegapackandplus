-- NEGATIVE STATUS CHECK

function HasNegativeStatus(entity)
    entity = entity or context.Source
    return HasStatus('SG_Stunned', entity) |
           HasStatus('SG_Frightened', entity) |
           HasStatus('SG_Restrained', entity) |
           HasStatus('SG_Charmed', entity) |
           HasStatus('SG_Incapacitated', entity) |
           HasStatus('SG_Paralyzed', entity) |
           HasStatus('SG_Petrified', entity) |
           HasStatus('SG_Polymorph', entity) |
           HasStatus('SG_Confused', entity) |
           HasStatus('SG_Cursed', entity) |
           HasStatus('SG_Disease', entity) |
           HasStatus('SG_Poisoned', entity) |
           HasStatus('SG_Sleeping', entity) |
           HasStatus('SG_Dominated', entity) |
           HasStatus('SG_Mad', entity) |
           HasStatus('SG_Taunted', entity) |
           HasStatus('SG_Blinded', entity) |
           HasStatus('SG_Prone', entity) |
           HasStatus('BURNING', entity) |
           HasStatus('BLEEDING', entity) |
           HasStatus('POISONED', entity) |
           HasStatus('BLINDED', entity) |
           HasStatus('MAG_FROST', entity) |
           HasStatus('MAG_THUNDER_REVERBERATION', entity)
end

function IsWildMagic(entity)
    return IsSpellChildOrVariantFromContext('Projectile_WildMagic') |
           IsSpellChildOrVariantFromContext('Target_WildMagic') |
           IsSpellChildOrVariantFromContext('Shout_WildMagic')
end

function IsInflictWounds(entity)
    return IsSpellChildOrVariantFromContext('Target_InflictWounds') |
           IsSpellChildOrVariantFromContext('AMP_Target_InflictWounds')
end

function IsArcaneLock(entity)
    return IsSpellChildOrVariantFromContext('Target_ArcaneLock')
end

-- Check if entity stands on a liquid surface (water, blood, oil, poison, lava, grease, etc.)
-- Used for Thunder Ring T3: liquid-surface aura that applies Reverberation on turn start.
function IsLiquidSurface(entity)
    entity = entity or context.Target
    return InSurface('SurfaceWater', entity) |
           InSurface('SurfaceWaterElectrified', entity) |
           InSurface('SurfaceWaterFrozen', entity) |
           InSurface('SurfaceBlood', entity) |
           InSurface('SurfaceBloodElectrified', entity) |
           InSurface('SurfaceBloodFrozen', entity) |
           InSurface('SurfacePoison', entity) |
           InSurface('SurfaceOil', entity) |
           InSurface('SurfaceLava', entity) |
           InSurface('SurfaceGrease', entity) |
           InSurface('SurfaceWyvernPoison', entity) |
           InSurface('SurfaceDeepwater', entity) |
           InSurface('SurfaceAlcohol', entity) |
           InSurface('SurfaceBloodSilver', entity) |
           InSurface('SurfaceCausticBrine', entity) |
           InSurface('SurfaceSewer', entity)
end

-- Esoteric Combat (Valdryn) kick gating, ported from KickMaster mod.
-- Active when: not in beast shape, no melee weapon in main hand, no shield equipped.
function AMP_KM_CanKick()
    return ~HasStatus('SG_Polymorph_BeastShape', context.Source)
         & ~WieldingWeapon('Melee', false, false, context.Source)
         & ~HasShieldEquipped(context.Source)
end
