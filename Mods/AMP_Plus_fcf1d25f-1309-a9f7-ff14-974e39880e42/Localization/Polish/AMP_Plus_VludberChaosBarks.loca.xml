<?xml version="1.0" encoding="utf-8"?>
<contentList>
	<content contentuid="hc8b1e29cg8b8fg4f3ag9749g63afd37b175c" version="1">Osnowa słucha tylko mnie!</content>
	<content contentuid="h716c971egcdfag4234g885cg3abb4bb01ee8" version="1">Wszystko idzie zgodnie z planem!</content>
	<content contentuid="hdf7d14a2g149bg47f4gb0fcgf61ca6c8507b" version="1">Tylko ja tu wiem, co się dzieje!</content>

	<content contentuid="hc00670b3gaa2fg4c4cgb633g38499b8b3b81" version="1">To wszystko przez ciebie!</content>
	<content contentuid="h16f303ddg43f9g4789g9734gdb4ab5d7d06f" version="1">Nie patrz tak na mnie!</content>
	<content contentuid="haa92af78g674fg44dcg9a34gdc4bd3b57950" version="1">To sprawka Planu, nie moja!</content>

	<content contentuid="h8b6707fdga200g4ebcgb240g8c649b543b60" version="1">Masz, mały prezencik dla ciebie...</content>
	<content contentuid="hf240c669g97edg4445ga62fgef21e39cbf90" version="1">No proszę. O wiele weselej, prawda?</content>
	<content contentuid="h653fbe19g8cdbg4a89g9ebcgdf6a2192e1fb" version="1">Ucz się, szczeniaku!</content>

	<content contentuid="he96992c6gaa54g469aga24eg7b916c9c1708" version="1">Tak właśnie miało być!</content>
	<content contentuid="ha39ef657gdefdg4a5eg824egc8b348c602ec" version="1">Ups!</content>
	<content contentuid="h00acb8c8g0e83g4f0fg88a0ge2a2ae8f6c74" version="1">Bu! Nie bój się.</content>
</contentList>
